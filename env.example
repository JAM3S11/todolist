# Copy this file to .env.local and fill in the values from
# Firebase console → Project settings (gear icon) → General → Your apps → Web app → SDK setup and configuration → Config

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# The live address. Shared-list links, invitation emails and password-reset emails point here.
# When you run the app on localhost, links use localhost instead, so local trials stay local.
NEXT_PUBLIC_APP_URL=https://todolist.vercel.app

# Optional: set to true after installing the "Trigger Email from Firestore" extension (needs the Blaze plan)
NEXT_PUBLIC_INVITE_EMAILS=false

# Optional: set to true to use the local Firebase emulators instead of the real project (npm run emulators)
NEXT_PUBLIC_USE_EMULATORS=false
